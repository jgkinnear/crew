# LiveKit (copied into the app bundle at build time)
# Local server:
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# LiveKit Cloud (team usage):
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=APIxxxxxxxx
# LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

LIVEKIT_ROOM=deckee-huddle

# Fine-grained GitHub token with Contents: Read on this private repo.
# Baked into the app so installed copies can download updates. Never commit a real token.
# CREW_UPDATE_TOKEN=
